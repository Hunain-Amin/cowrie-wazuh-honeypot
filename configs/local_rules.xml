<group name="cowrie,honeypot,">

  <rule id="100001" level="5">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.session.connect</field>
    <description>Honeypot: New connection from $(data.src_ip)</description>
<mitre>
<id>T1595</id>
</mitre> 
 </rule>

  <rule id="100002" level="7">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.failed</field>
    <description>Honeypot: Failed login attempt from $(data.src_ip) - user: $(data.username) pass: $(data.password)</description>
 <mitre>
<id>T1110</id>
</mitre>
 </rule>

  <rule id="100003" level="10">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.login.success</field>
    <description>Honeypot: SUCCESSFUL login from $(data.src_ip) - user: $(data.username) pass: $(data.password)</description>
<mitre>
<id>T1110.001</id>
</mitre> 
 </rule>

  <rule id="100004" level="8">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.command.input</field>
    <description>Honeypot: Command executed by $(data.src_ip): $(data.input)</description>
<mitre>
<id>T1059</id>
</mitre> 
 </rule>

  <rule id="100005" level="6">
    <decoded_as>json</decoded_as>
    <field name="eventid">cowrie.session.closed</field>
    <description>Honeypot: Session closed from $(data.src_ip)</description>
  </rule>

</group>
